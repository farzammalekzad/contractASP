@using System.Globalization
@model ContractInvoice.Api.Model.Contract

@{
    ViewData["Title"] = "جزئیات قرارداد";

    string ShowText(string? value)
        => string.IsNullOrWhiteSpace(value) ? "—" : value;

    string ShowMoney(decimal? value)
        => value.HasValue
            ? value.Value.ToString(
                "#,##0.##",
                CultureInfo.GetCultureInfo("fa-IR"))
            : "—";

    var sections = new (
        string Title,
        (string Label, string Value)[] Fields
    )[]
    {
        (
            "اطلاعات اصلی قرارداد",
            new (string, string)[]
            {
                ("شناسه قرارداد", Model.Id.ToString()),
                ("شماره قرارداد", ShowText(Model.ContractNo)),
                ("موضوع قرارداد", ShowText(Model.Topic)),
                ("کد پروژه", ShowText(Model.ProjectCode)),
                ("سال قرارداد", ShowText(Model.ContractYear)),
                ("نوع قرارداد", ShowText(Model.Type)),
                ("وضعیت قرارداد", ShowText(Model.Status)),
                ("فعال بودن", Model.Active ? "فعال" : "غیرفعال"),
                ("نام کارفرما", ShowText(Model.PrincipalName)),
                ("شماره قرارداد درآمدی مرتبط",
                    ShowText(Model.ContractNoRelation))
            }
        ),

        (
            "اطلاعات مالی قرارداد",
            new (string, string)[]
            {
                ("مبلغ قرارداد", ShowMoney(Model.Price)),
                ("مبلغ پیش‌پرداخت",
                    ShowMoney(Model.AdvancePaymentAmount)),
                ("مبلغ برون‌سپاری",
                    ShowMoney(Model.OutSourcePrice))
            }
        ),

        (
            "اطلاعات مسئولان و ثبت‌کننده",
            new (string, string)[]
            {
                ("کد پرسنلی مدیر پروژه",
                    ShowText(Model.ProjectManagerPersonelCode)),
                ("کد پرسنلی حامی پروژه",
                    ShowText(Model.SponsorPersonelCode)),
                ("کد پرسنلی ثبت‌کننده",
                    ShowText(Model.LogSavePersonalCode))
            }
        ),

        (
            "اطلاعات زمانی و ابلاغ",
            new (string, string)[]
            {
                ("تاریخ شروع قرارداد",
                    ShowText(Model.StartDate)),
                ("تاریخ پایان قرارداد",
                    ShowText(Model.EndDate)),
                ("شماره نامه ابلاغ",
                    ShowText(Model.EblaghLetterNo)),
                ("تاریخ نامه ابلاغ",
                    ShowText(Model.EblaghLetterDate))
            }
        )
    };
}

<div class="page-container" dir="rtl">

    <div class="page-header mb-4">
        <div>
            <h1 class="page-title">جزئیات قرارداد</h1>
            <p class="page-subtitle">
                اطلاعات کامل قرارداد
                @Model.ContractNo
            </p>
        </div>
    </div>

    @foreach (var group in sections)
    {
        <div class="mb-4">

            <h5 class="fw-bold mb-3">
                @group.Title
            </h5>

            <div class="row g-3">

                @foreach (var field in group.Fields)
                {
                    <div class="col-12 col-md-6 col-xl-4">

                        <div class="card h-100 border-0 shadow-sm rounded-4">

                            <div class="card-body p-3">

                                <div class="text-muted small mb-2">
                                    @field.Label
                                </div>

                                <div class="fw-semibold text-break">
                                    @field.Value
                                </div>

                            </div>

                        </div>

                    </div>
                }

            </div>

        </div>
    }

    <div class="d-flex gap-2 mt-4">

        <a asp-action="Edit"
           asp-route-id="@Model.Id"
           class="btn btn-primary">
            ویرایش قرارداد
        </a>

        <a asp-action="Index"
           class="btn btn-outline-secondary">
            بازگشت به فهرست
        </a>

    </div>

</div>