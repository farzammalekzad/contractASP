@using System.Globalization
@model ContractInvoice.Api.Model.Contract

@{
    ViewData["Title"] = "جزئیات قرارداد";

    string ShowText(string? value)
        => string.IsNullOrWhiteSpace(value) ? "—" : value;

    string ShowMoney(decimal? value)
        => value.HasValue
            ? value.Value.ToString(
                "#,##0.##",
                CultureInfo.GetCultureInfo("fa-IR"))
            : "—";

    var sections = new (
        string Title,
        (string Label, string Value)[] Fields
    )[]
    {
        (
            "اطلاعات اصلی قرارداد",
            new (string, string)[]
            {
                ("شناسه قرارداد", Model.Id.ToString()),
                ("شماره قرارداد", ShowText(Model.ContractNo)),
                ("موضوع قرارداد", ShowText(Model.Topic)),
                ("کد پروژه", ShowText(Model.ProjectCode)),
                ("سال قرارداد", ShowText(Model.ContractYear)),
                ("نوع قرارداد", ShowText(Model.Type)),
                ("وضعیت قرارداد", ShowText(Model.Status)),
                ("فعال بودن", Model.Active ? "فعال" : "غیرفعال"),
                ("نام کارفرما", ShowText(Model.PrincipalName)),
                ("شماره قرارداد درآمدی مرتبط",
                    ShowText(Model.ContractNoRelation))
            }
        ),

        (
            "اطلاعات مالی قرارداد",
            new (string, string)[]
            {
                ("مبلغ قرارداد", ShowMoney(Model.Price)),
                ("مبلغ پیش‌پرداخت",
                    ShowMoney(Model.AdvancePaymentAmount)),
                ("مبلغ برون‌سپاری",
                    ShowMoney(Model.OutSourcePrice))
            }
        ),

        (
            "اطلاعات مسئولان و ثبت‌کننده",
            new (string, string)[]
            {
                ("کد پرسنلی مدیر پروژه",
                    ShowText(Model.ProjectManagerPersonelCode)),
                ("کد پرسنلی حامی پروژه",
                    ShowText(Model.SponsorPersonelCode)),
                ("کد پرسنلی ثبت‌کننده",
                    ShowText(Model.LogSavePersonalCode))
            }
        ),

        (
            "اطلاعات زمانی و ابلاغ",
            new (string, string)[]
            {
                ("تاریخ شروع قرارداد",
                    ShowText(Model.StartDate)),
                ("تاریخ پایان قرارداد",
                    ShowText(Model.EndDate)),
                ("شماره نامه ابلاغ",
                    ShowText(Model.EblaghLetterNo)),
                ("تاریخ نامه ابلاغ",
                    ShowText(Model.EblaghLetterDate))
            }
        )
    };
}

<div class="page-container" dir="rtl">

    <div class="page-header mb-4">
        <div>
            <h1 class="page-title">جزئیات قرارداد</h1>
            <p class="page-subtitle">
                اطلاعات کامل قرارداد
                @Model.ContractNo
            </p>
        </div>
    </div>
    @{
    var sectionColors = new[]
    {
            "card-blue",
            "card-green",
            "card-purple",
            "card-orange"
        };
        var sectionIndex = 0;
    }

    @foreach (var group in sections)
    {
        <div class="mb-4">

            <h5 class="fw-bold mb-3">
                @group.Title
            </h5>

            <div class="row g-3">

                @foreach (var field in group.Fields)
                {
                    <div class="col-12 col-md-6 col-xl-4">

                        <div class="field-card @sectionColors[sectionIndex] h-100">

                            <div class="card-body p-3">

                                <div class="text-muted small mb-2">
                                    @field.Label
                                </div>

                                <div class="fw-semibold text-break">
                                    @field.Value
                                </div>

                            </div>

                        </div>

                    </div>
                }

            </div>

        </div>

        sectionIndex++;
    }

    <div class="d-flex gap-2 mt-4">

        <a asp-action="Edit"
           asp-route-id="@Model.Id"
           class="btn btn-primary">
            ویرایش قرارداد
        </a>

        <a asp-action="Index"
           class="btn btn-outline-secondary">
            بازگشت به فهرست
        </a>

    </div>
    <div class="form-section" style="margin-top: 30px;">
        <h3 class="section-title">پیوست‌های قرارداد</h3>

        <form asp-controller="ContractAttachments"
            asp-action="Upload"
            method="post"
            enctype="multipart/form-data">

            @Html.AntiForgeryToken()

            <input type="hidden" name="contractId" value="@Model.Id" />

            <div class="form-field">
                <label class="form-label" for="documentType">نوع مدرک</label>
                <select id="documentType"
                        name="documentType"
                        class="form-select"
                        required>
                    <option value="">-- انتخاب نوع مدرک --</option>
                    <option value="قرارداد اصلی">قرارداد اصلی</option>
                    <option value="الحاقیه">الحاقیه</option>
                    <option value="تمدید">تمدید</option>
                    <option value="ضمانت‌نامه">ضمانت‌نامه</option>
                    <option value="سایر مدارک">سایر مدارک</option>
                </select>
            </div>

            <div class="form-field">
                <label class="form-label" for="file">انتخاب فایل</label>
                <input type="file"
                    id="file"
                    name="file"
                    class="form-control"
                    accept=".pdf,.doc,.docx,.xls,.xlsx,.jpg,.jpeg,.png"
                    required />
                <small>حداکثر حجم هر فایل: ۲۰ مگابایت</small>
            </div>

            <div class="form-actions">
                <button type="submit" class="btn btn-primary">
                    بارگذاری پیوست
                </button>
            </div>
        </form>
    </div>
    <div class="form-section">
        <h3 class="section-title">فهرست پیوست‌های قرارداد</h3>

        @if (Model.Attachments != null && Model.Attachments.Any())
        {
            <table class="table">
                <thead>
                    <tr>
                        <th>نام فایل</th>
                        <th>نوع مدرک</th>
                        <th>حجم فایل</th>
                        <th>تاریخ بارگذاری</th>
                        <th>عملیات</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var attachment in Model.Attachments)
                    {
                        <tr>
                            <td>@attachment.FileName</td>
                            <td>@attachment.DocumentType</td>
                            <td>@((attachment.FileSize / 1024.0 / 1024.0).ToString("F2")) مگابایت</td>
                            <td>@attachment.UploadedAt.ToLocalTime().ToString("yyyy/MM/dd HH:mm")</td>
                            <td>
                                <a asp-controller="ContractAttachments"
                                asp-action="Download"
                                asp-route-id="@attachment.Id"
                                class="btn btn-primary">
                                    دانلود
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
        else
        {
            <p>هنوز پیوستی برای این قرارداد ثبت نشده است.</p>
        }
    </div>


</div>