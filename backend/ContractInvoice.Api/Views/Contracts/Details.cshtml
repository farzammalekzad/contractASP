@model ContractInvoice.Api.Model.Contract

@{
    ViewData["Title"] = "جزئیات قرارداد";
}

<div class="page-container">

    <div class="page-header">
        <div>
            <h1 class="page-title">جزئیات قرارداد</h1>
            <p class="page-subtitle">
                @Model.ContractCode - @Model.Title
            </p>
        </div>
    </div>

    <div class="details-grid">

        <div class="field-card card-blue">
            <div class="field-label">کد قرارداد</div>
            <div class="field-value">@Model.ContractCode</div>
        </div>

        <div class="field-card card-purple">
            <div class="field-label">عنوان قرارداد</div>
            <div class="field-value">@Model.Title</div>
        </div>

        <div class="field-card card-green">
            <div class="field-label">نوع قرارداد</div>
            <div class="field-value">@Model.ContractType</div>
        </div>

        <div class="field-card card-orange">
            <div class="field-label">کد پروژه</div>
            <div class="field-value">@Model.ProjectCode</div>
        </div>

        <div class="field-card card-cyan">
            <div class="field-label">کارفرما</div>
            <div class="field-value">@Model.Employer</div>
        </div>

        <div class="field-card card-pink">
            <div class="field-label">مدیر پروژه</div>
            <div class="field-value">@(Model.ProjectManager ?? "-")</div>
        </div>

        <div class="field-card card-blue">
            <div class="field-label">حامی پروژه</div>
            <div class="field-value">@(Model.ProjectSponsor ?? "-")</div>
        </div>

        <div class="field-card card-green">
            <div class="field-label">مبلغ قرارداد</div>
            <div class="field-value">@Model.Amount.ToString("N0")</div>
        </div>

        <div class="field-card card-purple">
            <div class="field-label">مبلغ پیش‌پرداخت</div>
            <div class="field-value">
                @(Model.AdvancePaymentAmount?.ToString("N0") ?? "-")
            </div>
        </div>

        <div class="field-card card-orange">
            <div class="field-label">شماره نامه ابلاغ</div>
            <div class="field-value">
                @(Model.NotificationLetterNo ?? "-")
            </div>
        </div>

        <div class="field-card card-cyan">
            <div class="field-label">تاریخ نامه ابلاغ</div>
            <div class="field-value">
                @(Model.NotificationLetterDate ?? "-")
            </div>
        </div>

        <div class="field-card card-pink">
            <div class="field-label">تاریخ شروع قرارداد</div>
            <div class="field-value">
                @(Model.ContractStartDate ?? "-")
            </div>
        </div>

        <div class="field-card card-blue">
            <div class="field-label">تاریخ پایان قرارداد</div>
            <div class="field-value">
                @(Model.ContractEndDate ?? "-")
            </div>
        </div>

        <div class="field-card card-green">
            <div class="field-label">قرارداد درآمدی مرتبط</div>
            <div class="field-value">
                @(Model.RelatedRevenueContractCode ?? "-")
            </div>
        </div>

    </div>

    <div class="mt-4">
        <a asp-action="Edit"
           asp-route-id="@Model.Id"
           class="btn btn-warning">
            ویرایش
        </a>

        <a asp-action="Index"
           class="btn btn-secondary">
            بازگشت
        </a>
    </div>

</div>