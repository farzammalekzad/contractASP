@model ContractInvoice.Api.DTOs.UpdateContractDto

@{
    ViewData["Title"] = "ویرایش قرارداد";
}

<div class="page-container compact-form">

    <div class="page-header">
        <div>
            <h1 class="page-title">ویرایش قرارداد </h1>
            <p class="page-subtitle">
                اطلاعات اصلی قرارداد را ویرایش کنید
            </p>
        </div>
    </div>

    <form asp-action="Edit" method="post">

        <div asp-validation-summary="ModelOnly"
             class="alert alert-danger">
        </div>


        <div class="form-section">

            <div class="form-section-title">
                اطلاعات پایه
            </div>

            <div class="form-grid">

                <div class="form-field">
                    <label asp-for="ContractCode"
                           class="form-label"></label>

                    <input asp-for="ContractCode"
                           class="form-control" />

                    <span asp-validation-for="ContractCode"
                          class="text-danger"></span>
                </div>


                <div class="form-field">
                    <label asp-for="Title"
                           class="form-label"></label>

                    <input asp-for="Title"
                           class="form-control" />

                    <span asp-validation-for="Title"
                          class="text-danger"></span>
                </div>


                <div class="form-field">
                    <label asp-for="ContractType"
                           class="form-label"></label>

                    <select asp-for="ContractType"
                            class="form-select">

                        <option value="">
                            -- انتخاب نوع قرارداد --
                        </option>

                        <option value="INCOME">
                            درآمدی
                        </option>

                        <option value="EXPENSE">
                            هزینه‌ای
                        </option>

                    </select>

                    <span asp-validation-for="ContractType"
                          class="text-danger"></span>
                </div>


                <div class="form-field">
                    <label asp-for="ProjectCode"
                           class="form-label"></label>

                    <input asp-for="ProjectCode"
                           class="form-control" />

                    <span asp-validation-for="ProjectCode"
                          class="text-danger"></span>
                </div>


                <div class="form-field">
                    <label asp-for="Employer"
                           class="form-label"></label>

                    <input asp-for="Employer"
                           class="form-control" />
                </div>


                <div class="form-field">
                    <label asp-for="ProjectManager"
                           class="form-label"></label>

                    <input asp-for="ProjectManager"
                           class="form-control" />
                </div>


                <div class="form-field">
                    <label asp-for="ProjectSponsor"
                           class="form-label"></label>

                    <input asp-for="ProjectSponsor"
                           class="form-control" />
                </div>


                <div class="form-field">
                    <label asp-for="RelatedRevenueContractCode"
                           class="form-label"></label>

                    <input asp-for="RelatedRevenueContractCode"
                           class="form-control" />
                </div>

            </div>

        </div>


        <div class="form-section">

            <div class="form-section-title">
                اطلاعات مالی
            </div>

            <div class="form-grid">

                <div class="form-field">
                    <label asp-for="Amount"
                           class="form-label"></label>

                    <input asp-for="Amount"
                           class="form-control" />

                    <span asp-validation-for="Amount"
                          class="text-danger"></span>
                </div>


                <div class="form-field">
                    <label asp-for="AdvancePaymentAmount"
                           class="form-label"></label>

                    <input asp-for="AdvancePaymentAmount"
                           class="form-control" />

                    <span asp-validation-for="AdvancePaymentAmount"
                          class="text-danger"></span>
                </div>

            </div>

        </div>


        <div class="form-section">

            <div class="form-section-title">
                اطلاعات زمانی و ابلاغ
            </div>

            <div class="form-grid">

                <div class="form-field">
                    <label asp-for="NotificationLetterNo"
                           class="form-label"></label>

                    <input asp-for="NotificationLetterNo"
                           class="form-control" />
                </div>


                <div class="form-field">
                    <label asp-for="NotificationLetterDate"
                           class="form-label"></label>

                    <input asp-for="NotificationLetterDate"
                           class="form-control"
                           placeholder="1405/07/19" />
                </div>


                <div class="form-field">
                    <label asp-for="ContractStartDate"
                           class="form-label"></label>

                    <input asp-for="ContractStartDate"
                           class="form-control"
                           placeholder="1405/07/19" />
                </div>


                <div class="form-field">
                    <label asp-for="ContractEndDate"
                           class="form-label"></label>

                    <input asp-for="ContractEndDate"
                           class="form-control"
                           placeholder="1406/07/19" />
                </div>

            </div>

        </div>


        <div class="form-actions">

            <button type="submit"
                    class="btn btn-primary-modern">
                ذخیره قرارداد
            </button>

            <a asp-action="Index"
               class="btn btn-outline-secondary btn-soft">
                انصراف
            </a>

        </div>

    </form>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}