@model ContractInvoice.Api.Model.Contract

@{
    ViewData["Title"] = "حذف قرارداد";
}

<div class="page-container">

    <div class="page-header">
        <div>
            <h1 class="page-title">حذف قرارداد</h1>
            <p class="page-subtitle">
                بررسی نهایی قبل از حذف قرارداد
            </p>
        </div>
    </div>

    <div class="delete-card">

        @if (ViewBag.ErrorMessage != null)
        {
            <div class="alert alert-danger">
                @ViewBag.ErrorMessage
            </div>
        }

        <div class="delete-warning">
            آیا از حذف این قرارداد مطمئن هستید؟
            این عملیات قابل بازگشت نیست.
        </div>

        <div class="delete-summary">

            <div class="delete-item">
                <div class="delete-item-label">کد قرارداد</div>
                <div class="delete-item-value">
                    @Model.ContractCode
                </div>
            </div>

            <div class="delete-item">
                <div class="delete-item-label">عنوان قرارداد</div>
                <div class="delete-item-value">
                    @Model.Title
                </div>
            </div>

            <div class="delete-item">
                <div class="delete-item-label">کارفرما</div>
                <div class="delete-item-value">
                    @Model.Employer
                </div>
            </div>

            <div class="delete-item">
                <div class="delete-item-label">مبلغ قرارداد</div>
                <div class="delete-item-value">
                    @Model.Amount.ToString("N0")
                </div>
            </div>

        </div>

        <form asp-action="Delete" method="post">

            <input type="hidden"
                   asp-for="Id" />

            <div class="delete-actions">

                <button type="submit"
                        class="btn btn-danger">
                    حذف قرارداد
                </button>

                <a asp-action="Index"
                   class="btn btn-outline-secondary">
                    انصراف
                </a>

            </div>

        </form>

    </div>

</div>