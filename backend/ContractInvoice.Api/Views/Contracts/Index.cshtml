@model List<ContractInvoice.Api.Model.Contract>

@{
    ViewData["Title"] = "Contracts";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>Contracts</h2>

    <a asp-controller="Contracts"
       asp-action="Create"
       class="btn btn-primary">
        New Contract
    </a>
</div>

<table class="table table-striped table-bordered">
    <thead class="table-dark">
        <tr>
            <th>Id</th>
            <th>Contract Code</th>
            <th>Title</th>
            <th>Project Manager</th>
            <th>Amount</th>
            <th>Actions</th>
        </tr>
    </thead>

    <tbody>
        @foreach (var contract in Model)
        {
            <tr>
                <td>@contract.Id</td>
                <td>@contract.ContractCode</td>
                <td>@contract.Title</td>
                <td>@contract.ProjectManager</td>
                <td>@contract.Amount.ToString("N0")</td>
                <td class="text-nowrap">
                    <a asp-action="Details" asp-route-id="@contract.Id" class="btn btn-sm btn-outline-info">Details</a>
                    <a asp-action="Edit" asp-route-id="@contract.Id" class="btn btn-sm btn-outline-primary">Edit</a>
                    <a asp-action="Delete" asp-route-id="@contract.Id" class="btn btn-sm btn-outline-danger">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>
