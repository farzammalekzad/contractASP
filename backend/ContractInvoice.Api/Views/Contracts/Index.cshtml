@model IEnumerable<ContractInvoice.Api.Model.Contract>

@{
    ViewData["Title"] = "قراردادها";
}

<div class="page-container">

    <div class="page-header">

        <div>
            <h1 class="page-title">قراردادها</h1>
            <p class="page-subtitle">
                مدیریت و مشاهده قراردادهای ثبت شده
            </p>
        </div>

        <a asp-action="Create"
           class="btn btn-primary-modern">
            + قرارداد جدید
        </a>

    </div>

    <div class="modern-table-wrapper">

        <table class="table modern-table">

            <thead>
                <tr>
                    <th>کد قرارداد</th>
                    <th>عنوان</th>
                    <th>نوع</th>
                    <th>کارفرما</th>
                    <th>مبلغ قرارداد</th>
                    <th>عملیات</th>
                </tr>
            </thead>

            <tbody>

                @foreach (var item in Model)
                {
                    <tr>

                        <td>
                            <strong>@item.ContractCode</strong>
                        </td>

                        <td>
                            @item.Title
                        </td>

                        <td>
                            @if (item.ContractType == "INCOME")
                            {
                                <span class="badge badge-soft-success">
                                    درآمدی
                                </span>
                            }
                            else if (item.ContractType == "EXPENSE")
                            {
                                <span class="badge badge-soft-danger">
                                    هزینه‌ای
                                </span>
                            }
                            else
                            {
                                <span class="badge badge-soft-secondary">
                                    @item.ContractType
                                </span>
                            }
                        </td>

                        <td>
                            @item.Employer
                        </td>

                        <td>
                            @item.Amount.ToString("N0")
                        </td>

                        <td>
                            <div class="d-flex gap-2 flex-wrap">

                                <a asp-action="Details"
                                   asp-route-id="@item.Id"
                                   class="btn btn-outline-primary btn-sm btn-soft">
                                    جزئیات
                                </a>

                                <a asp-action="Edit"
                                   asp-route-id="@item.Id"
                                   class="btn btn-outline-warning btn-sm btn-soft">
                                    ویرایش
                                </a>

                                <a asp-action="Delete"
                                   asp-route-id="@item.Id"
                                   class="btn btn-outline-danger btn-sm btn-soft">
                                    حذف
                                </a>

                            </div>
                        </td>

                    </tr>
                }

            </tbody>

        </table>

    </div>

</div>