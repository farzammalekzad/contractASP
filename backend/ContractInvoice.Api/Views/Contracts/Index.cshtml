@model IEnumerable<ContractInvoice.Api.Model.Contract>

@{
    ViewData["Title"] = "قراردادها";

    string ShowMoney(decimal? value)
        => value.HasValue
            ? value.Value.ToString("N0")
            : "—";
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger">
        @TempData["ErrorMessage"]
    </div>
}

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success">
        @TempData["SuccessMessage"]
    </div>
}

<div class="page-container">

    <div class="page-header">

        <div>
            <h1 class="page-title">قراردادها</h1>
            <p class="page-subtitle">
                مدیریت و مشاهده قراردادهای ثبت‌شده
            </p>
        </div>

        <a asp-action="Create"
           class="btn btn-primary-modern">
            + قرارداد جدید
        </a>

    </div>

    <div class="card mb-4 shadow-sm">
        <div class="card-header bg-light d-flex align-items-center justify-content-between">
            <h6 class="mb-0">
                <i class="bi bi-search me-2"></i>
                جستجو و فیلتر قراردادها
            </h6>
            <button type="button"
                    id="clearContractFilters"
                    class="btn btn-sm btn-outline-secondary">
                پاک کردن فیلترها
            </button>
        </div>

        <div class="card-body">
            <div class="row g-3">

                <!-- شماره قرارداد -->
                <div class="col-md-2">
                    <label class="form-label">شماره قرارداد</label>
                    <input type="text" class="form-control contract-filter"
                        data-column="0"
                        placeholder="شماره قرارداد..." />
                </div>

                <!-- موضوع -->
                <div class="col-md-4">
                    <label class="form-label">موضوع قرارداد</label>
                    <input type="text" class="form-control contract-filter"
                        data-column="1"
                        placeholder="موضوع قرارداد..." />
                </div>

                <!-- نوع قرارداد -->
                <div class="col-md-1">
                    <label class="form-label">نوع قرارداد</label>
                    <select class="form-select contract-filter" data-column="2">
                        <option value="">همه</option>
                        <option value="درآمدی">درآمدی</option>
                        <option value="هزینه‌ای">هزینه‌ای</option>
                        <option value="داخلی">داخلی</option>
                    </select>
                </div>

                <!-- وضعیت -->
                <div class="col-md-1">
                    <label class="form-label">وضعیت</label>
                    <select class="form-select contract-filter" data-column="3">
                        <option value="">همه</option>
                        <option value="جاری">جاری</option>
                        <option value="خاتمه یافته">خاتمه یافته</option>
                        <option value="فسخ شده">فسخ شده</option>
                    </select>
                </div>

                <!-- فعال بودن -->
                <div class="col-md-1">
                    <label class="form-label">فعال بودن</label>
                    <select class="form-select contract-filter" data-column="4">
                        <option value="">همه</option>
                        <option value="فعال">فعال</option>
                        <option value="غیرفعال">غیرفعال</option>
                    </select>
                </div>

                <!-- کارفرما -->
                <div class="col-md-3">
                    <label class="form-label">کارفرما</label>
                    <input type="text" class="form-control contract-filter"
                        data-column="5"
                        placeholder="نام کارفرما..." />
                </div>

            </div>
        </div>
    </div>

    <div class="modern-table-wrapper">

        <div class="table-responsive">

            <table class="table modern-table">

                <thead>
                    <tr>
                        <th>شماره قرارداد</th>
                        <th>موضوع قرارداد</th>
                        <th>نوع قرارداد</th>
                        <th>وضعیت</th>
                        <th>فعال</th>
                        <th>کارفرما</th>
                        <th>مبلغ قرارداد</th>
                        <th>عملیات</th>
                    </tr>
                </thead>

                <tbody>

                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="8" class="text-center py-4">
                                قراردادی ثبت نشده است.
                            </td>
                        </tr>
                    }

                    @foreach (var item in Model)
                    {
                        <tr>

                            <td>
                                <strong>@item.ContractNo</strong>
                            </td>

                            <td>
                                @item.Topic
                            </td>

                            <td>
                                @if (item.Type == "درآمدی")
                                {
                                    <span class="badge badge-soft-success">
                                        درآمدی
                                    </span>
                                }
                                else if (item.Type == "هزینه‌ای")
                                {
                                    <span class="badge badge-soft-danger">
                                        هزینه‌ای
                                    </span>
                                }
                                else
                                {
                                    <span class="badge badge-soft-secondary">
                                        @item.Type
                                    </span>
                                }
                            </td>

                            <td>
                                @if (item.Status == "جاری")
                                {
                                    <span class="badge badge-soft-success">
                                        جاری
                                    </span>
                                }
                                else if (item.Status == "خاتمه یافته")
                                {
                                    <span class="badge badge-soft-secondary">
                                        خاتمه یافته
                                    </span>
                                }
                                else if (item.Status == "فسخ شده")
                                {
                                    <span class="badge badge-soft-danger">
                                        فسخ شده
                                    </span>
                                }
                                else
                                {
                                    <span class="badge badge-soft-secondary">
                                        @item.Status
                                    </span>
                                }
                            </td>

                            <td>
                                @if (item.Active)
                                {
                                    <span class="badge badge-soft-success">
                                        فعال
                                    </span>
                                }
                                else
                                {
                                    <span class="badge badge-soft-secondary">
                                        غیرفعال
                                    </span>
                                }
                            </td>

                            <td>
                                @(item.Principal?.Name ?? "—")
                            </td>

                            <td>
                                @ShowMoney(item.Price)
                            </td>

                            <td>
                                <div class="d-flex gap-2 flex-wrap">

                                    <a asp-action="Details"
                                       asp-route-id="@item.Id"
                                       class="btn btn-outline-primary btn-sm btn-soft">
                                        جزئیات
                                    </a>

                                    <a asp-action="Edit"
                                       asp-route-id="@item.Id"
                                       class="btn btn-outline-warning btn-sm btn-soft">
                                        ویرایش
                                    </a>

                                    <button type="button"
                                            class="btn btn-outline-danger btn-sm btn-soft"
                                            data-bs-toggle="modal"
                                            data-bs-target="#deleteContractModal-@item.Id">
                                        حذف
                                    </button>

                                </div>
                            </td>

                        </tr>
                    }

                </tbody>

            </table>

        </div>

    </div>

    @* Delete confirmation modals *@

    @foreach (var item in Model)
    {
        <div class="modal fade"
             id="deleteContractModal-@item.Id"
             tabindex="-1"
             aria-hidden="true">

            <div class="modal-dialog modal-dialog-centered">

                <div class="modal-content">

                    <div class="modal-header border-0">

                        <h5 class="modal-title">
                            حذف قرارداد
                        </h5>

                    </div>

                    <div class="modal-body">

                        <div class="delete-warning">
                            آیا از حذف این قرارداد مطمئن هستید؟
                        </div>

                        <div class="delete-modal-grid">

                            <div class="delete-modal-card delete-card-blue">

                                <div class="delete-modal-card-label">
                                    شماره قرارداد
                                </div>

                                <div class="delete-modal-card-value">
                                    @item.ContractNo
                                </div>

                            </div>

                            <div class="delete-modal-card delete-card-purple">

                                <div class="delete-modal-card-label">
                                    موضوع قرارداد
                                </div>

                                <div class="delete-modal-card-value">
                                    @item.Topic
                                </div>

                            </div>

                            <div class="delete-modal-card delete-card-green">

                                <div class="delete-modal-card-label">
                                    کارفرما
                                </div>

                                <div class="delete-modal-card-value">
                                    @(item.Principal?.Name ?? "—")
                                </div>

                            </div>

                            <div class="delete-modal-card delete-card-orange">

                                <div class="delete-modal-card-label">
                                    مبلغ قرارداد
                                </div>

                                <div class="delete-modal-card-value">
                                    @ShowMoney(item.Price)
                                </div>

                            </div>

                        </div>

                    </div>

                    <div class="modal-footer border-0">

                        <form asp-action="Delete"
                              asp-route-id="@item.Id"
                              method="post">

                            @Html.AntiForgeryToken()

                            <button type="submit"
                                    class="btn btn-danger">
                                بله، حذف شود
                            </button>

                        </form>

                        <button type="button"
                                class="btn btn-outline-secondary"
                                data-bs-dismiss="modal">
                            انصراف
                        </button>

                    </div>

                </div>

            </div>

        </div>
    }

    <script>
        document.addEventListener('DOMContentLoaded', function () {

            const filters = document.querySelectorAll('.contract-filter');
            const tableRows = document.querySelectorAll('.modern-table tbody tr');

            function normalizeText(value) {
                return value
                    .replace(/\u200c/g, '')
                    .replace(/\s+/g, ' ')
                    .trim()
                    .toLowerCase();
            }

            function filterContracts() {

                tableRows.forEach(row => {

                    const cells = row.querySelectorAll('td');

                    // رد کردن ردیف پیام «قراردادی ثبت نشده است»
                    if (cells.length !== 8) return;

                    let visible = true;

                    filters.forEach(filter => {

                        const columnIndex = Number(filter.dataset.column);
                        const filterValue = normalizeText(filter.value);

                        if (!filterValue) return;

                        const cellValue = normalizeText(cells[columnIndex].textContent);

                        if (!cellValue.includes(filterValue)) {
                            visible = false;
                        }

                    });

                    row.style.display = visible ? '' : 'none';
                });
            }

            filters.forEach(filter => {
                filter.addEventListener('input', filterContracts);
                filter.addEventListener('change', filterContracts);
            });

            document.getElementById('clearContractFilters')
                .addEventListener('click', function () {

                    filters.forEach(filter => {
                        filter.value = '';
                    });

                    filterContracts();
                });

        });
    </script>

</div>