@model IEnumerable<ContractInvoice.Api.Model.Contract>

@{
    ViewData["Title"] = "قراردادها";
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger">
        @TempData["ErrorMessage"]
    </div>
}

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success">
        @TempData["SuccessMessage"]
    </div>
}

<div class="page-container">

    <div class="page-header">

        <div>
            <h1 class="page-title">قراردادها</h1>
            <p class="page-subtitle">
                مدیریت و مشاهده قراردادهای ثبت شده
            </p>
        </div>

        <a asp-action="Create"
           class="btn btn-primary-modern">
            + قرارداد جدید
        </a>

    </div>

    <div class="modern-table-wrapper">

        <table class="table modern-table">

            <thead>
                <tr>
                    <th>کد قرارداد</th>
                    <th>عنوان</th>
                    <th>نوع</th>
                    <th>کارفرما</th>
                    <th>مبلغ قرارداد</th>
                    <th>عملیات</th>
                </tr>
            </thead>

            <tbody>

                @foreach (var item in Model)
                {
                    <tr>

                        <td>
                            <strong>@item.ContractCode</strong>
                        </td>

                        <td>
                            @item.Title
                        </td>

                        <td>
                            @if (item.ContractType == "INCOME")
                            {
                                <span class="badge badge-soft-success">
                                    درآمدی
                                </span>
                            }
                            else if (item.ContractType == "EXPENSE")
                            {
                                <span class="badge badge-soft-danger">
                                    هزینه‌ای
                                </span>
                            }
                            else
                            {
                                <span class="badge badge-soft-secondary">
                                    @item.ContractType
                                </span>
                            }
                        </td>

                        <td>
                            @item.Employer
                        </td>

                        <td>
                            @item.Amount.ToString("N0")
                        </td>

                        <td>
                            <div class="d-flex gap-2 flex-wrap">

                                <a asp-action="Details"
                                   asp-route-id="@item.Id"
                                   class="btn btn-outline-primary btn-sm btn-soft">
                                    جزئیات
                                </a>

                                <a asp-action="Edit"
                                   asp-route-id="@item.Id"
                                   class="btn btn-outline-warning btn-sm btn-soft">
                                    ویرایش
                                </a>

                                <button type="button"
                                class="btn btn-outline-danger btn-sm btn-soft"
                                data-bs-toggle="modal"
                                data-bs-target="#deleteContractModal-@item.Id">
                                حذف
                                </button>

                            </div>
                        </td>

                    </tr>
                    
                }

            </tbody>

        </table>
        

        @foreach (var item in Model)
        {
            <div class="modal fade"
                id="deleteContractModal-@item.Id"
                tabindex="-1"
                aria-hidden="true">

                 <div class="modal-dialog modal-dialog-centered">
                    <div class="modal-content">

                        <div class="modal-header border-0">
                            <h5 class="modal-title">
                                حذف قرارداد
                            </h5>

                        
                        </div>

                        <div class="modal-body">

                            <div class="delete-warning">
                                آیا از حذف این قرارداد مطمئن هستید؟
                            </div>

                            <div class="delete-modal-grid">

                                <div class="delete-modal-card delete-card-blue">
                                    <div class="delete-modal-card-label">
                                        کد قرارداد
                                    </div>

                                    <div class="delete-modal-card-value">
                                        @item.ContractCode
                                    </div>
                                </div>


                                <div class="delete-modal-card delete-card-purple">
                                    <div class="delete-modal-card-label">
                                        عنوان قرارداد
                                    </div>

                                    <div class="delete-modal-card-value">
                                        @item.Title
                                    </div>
                                </div>


                                <div class="delete-modal-card delete-card-green">
                                    <div class="delete-modal-card-label">
                                        کارفرما
                                    </div>

                                    <div class="delete-modal-card-value">
                                        @item.Employer
                                    </div>
                                </div>


                                <div class="delete-modal-card delete-card-orange">
                                    <div class="delete-modal-card-label">
                                        مبلغ قرارداد
                                    </div>

                                    <div class="delete-modal-card-value">
                                        @item.Amount.ToString("N0")
                                    </div>
                                </div>

                            </div>

                        </div>

                        <div class="modal-footer border-0">

                            <form asp-action="Delete"
                                asp-route-id="@item.Id"
                                method="post">

                                @Html.AntiForgeryToken()

                                <button type="submit"
                                        class="btn btn-danger">
                                    بله، حذف شود
                                </button>

                            </form>

                            <button type="button"
                                    class="btn btn-outline-secondary"
                                    data-bs-dismiss="modal">
                                انصراف
                            </button>

                        </div>

                    </div>
                </div>

            </div>
        }

    </div>

</div>