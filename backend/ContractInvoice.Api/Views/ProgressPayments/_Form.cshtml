@model ContractInvoice.Api.DTOs.CreateProgressPaymentDto
<div asp-validation-summary="ModelOnly" class="text-danger"></div>
<div class="mb-3"><label asp-for="ContractId" class="form-label"></label><select asp-for="ContractId" asp-items="ViewBag.Contracts" class="form-select"><option value="">-- انتخاب قرارداد --</option></select><span asp-validation-for="ContractId" class="text-danger"></span></div>
<div class="mb-3"><label asp-for="PaymentNo" class="form-label"></label><input asp-for="PaymentNo" class="form-control" /><span asp-validation-for="PaymentNo" class="text-danger"></span></div>
<div class="mb-3"><label asp-for="Title" class="form-label"></label><input asp-for="Title" class="form-control" /><span asp-validation-for="Title" class="text-danger"></span></div>
<div class="mb-3"><label asp-for="PaymentType" class="form-label"></label><select asp-for="PaymentType" class="form-select"><option value="">-- انتخاب نوع --</option><option value="TEMPORARY">TEMPORARY</option><option value="FINAL">FINAL</option><option value="ADJUSTMENT">ADJUSTMENT</option></select><span asp-validation-for="PaymentType" class="text-danger"></span></div>
<div class="row"><div class="col-md-6 mb-3"><label asp-for="PeriodStartDate" class="form-label"></label><input asp-for="PeriodStartDate" class="form-control" /><span asp-validation-for="PeriodStartDate" class="text-danger"></span></div><div class="col-md-6 mb-3"><label asp-for="PeriodEndDate" class="form-label"></label><input asp-for="PeriodEndDate" class="form-control" /><span asp-validation-for="PeriodEndDate" class="text-danger"></span></div></div>
<div class="row"><div class="col-md-6 mb-3"><label asp-for="RequestLetterNo" class="form-label"></label><input asp-for="RequestLetterNo" class="form-control" /></div><div class="col-md-6 mb-3"><label asp-for="RequestLetterDate" class="form-label"></label><input asp-for="RequestLetterDate" class="form-control" /></div></div>
<div class="row"><div class="col-md-6 mb-3"><label asp-for="ApprovalLetterNo" class="form-label"></label><input asp-for="ApprovalLetterNo" class="form-control" /></div><div class="col-md-6 mb-3"><label asp-for="ApprovalDate" class="form-label"></label><input asp-for="ApprovalDate" class="form-control" /></div></div>
<div class="row"><div class="col-md-6 mb-3"><label asp-for="ProposedAmount" class="form-label"></label><input asp-for="ProposedAmount" class="form-control" /><span asp-validation-for="ProposedAmount" class="text-danger"></span></div><div class="col-md-6 mb-3"><label asp-for="ApprovedAmount" class="form-label"></label><input asp-for="ApprovedAmount" class="form-control" /><span asp-validation-for="ApprovedAmount" class="text-danger"></span></div></div>
<div class="mb-3"><label asp-for="Status" class="form-label"></label><input asp-for="Status" class="form-control" /><span asp-validation-for="Status" class="text-danger"></span></div>
