@model ContractInvoice.Api.ViewModels.ProgressPaymentHistoryModel
@{ ViewData["Title"] = "جزئیات صورت وضعیت"; var totalPaid = Model.TotalAllocated; var remainingAmount = Model.RemainingAmount; var payments = Model.Allocations; }
<div class="page-container">

    <div class="page-header">
        <div>
            <h1 class="page-title">جزئیات صورت وضعیت</h1>

            <p class="page-subtitle">
                @Model.ProgressPayment.Contract.ContractNo
                -
                صورت وضعیت شماره @Model.ProgressPayment.PaymentNo
            </p>
        </div>
    </div>


    <div class="details-grid">

        <div class="field-card card-blue">
            <div class="field-label">قرارداد</div>
            <div class="field-value">
                @Model.ProgressPayment.Contract.ContractNo
            </div>
        </div>

        <div class="field-card card-purple">
            <div class="field-label">شماره صورت وضعیت</div>
            <div class="field-value">
                @Model.ProgressPayment.PaymentNo
            </div>
        </div>

        <div class="field-card card-green">
            <div class="field-label">عنوان صورت وضعیت</div>
            <div class="field-value">
                @Model.ProgressPayment.Title
            </div>
        </div>

        <div class="field-card card-orange">
            <div class="field-label">نوع صورت وضعیت</div>
            <div class="field-value">
                @Model.ProgressPayment.PaymentType
            </div>
        </div>

        <div class="field-card card-cyan">
            <div class="field-label">تاریخ شروع دوره</div>
            <div class="field-value">
                @(Model.ProgressPayment.PeriodStartDate ?? "-")
            </div>
        </div>

        <div class="field-card card-pink">
            <div class="field-label">تاریخ پایان دوره</div>
            <div class="field-value">
                @(Model.ProgressPayment.PeriodEndDate ?? "-")
            </div>
        </div>

        <div class="field-card card-blue">
            <div class="field-label">شماره نامه درخواست</div>
            <div class="field-value">
                @(Model.ProgressPayment.RequestLetterNo ?? "-")
            </div>
        </div>

        <div class="field-card card-purple">
            <div class="field-label">تاریخ نامه درخواست</div>
            <div class="field-value">
                @(Model.ProgressPayment.RequestLetterDate ?? "-")
            </div>
        </div>

        <div class="field-card card-green">
            <div class="field-label">شماره نامه تایید</div>
            <div class="field-value">
                @(Model.ProgressPayment.ApprovalLetterNo ?? "-")
            </div>
        </div>

        <div class="field-card card-orange">
            <div class="field-label">تاریخ تایید</div>
            <div class="field-value">
                @(Model.ProgressPayment.ApprovalDate ?? "-")
            </div>
        </div>

        <div class="field-card card-cyan">
            <div class="field-label">مبلغ پیشنهادی</div>
            <div class="field-value">
                @Model.ProgressPayment.ProposedAmount.ToString("N2")
            </div>
        </div>

        <div class="field-card card-pink">
            <div class="field-label">مبلغ تایید شده</div>
            <div class="field-value">
                @(Model.ProgressPayment.ApprovedAmount?.ToString("N2") ?? "-")
            </div>
        </div>

        <div class="field-card card-gray">
            <div class="field-label">وضعیت</div>
            <div class="field-value">
                @(Model.ProgressPayment.Status ?? "-")
            </div>
        </div>

    </div>


    <hr class="my-4" />

    <h4 class="mb-3">وضعیت مالی</h4>

    <div class="row g-3 mb-4">

        <div class="col-md-4">
            <div class="summary-card">
                <div class="summary-label">
                    مبلغ تایید شده
                </div>

                <div class="summary-value">
                    @(Model.ProgressPayment.ApprovedAmount?.ToString("N2") ?? "-")
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="summary-card">
                <div class="summary-label">
                    مجموع پرداخت‌ها
                </div>

                <div class="summary-value">
                    @totalPaid.ToString("N2")
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="summary-card">
                <div class="summary-label">
                    مانده
                </div>

                <div class="summary-value">
                    @if (remainingAmount.HasValue)
                    {
                        @remainingAmount.Value.ToString("N2")
                    }
                    else
                    {
                        <span>-</span>
                    }
                </div>
            </div>
        </div>

    </div>


    <div class="d-flex justify-content-between align-items-center mb-3">

        <h4 class="mb-0">
            پرداخت‌های این صورت وضعیت
        </h4>

        <a asp-controller="Payments"
           asp-action="Create"
           asp-route-progressPaymentId="@Model.ProgressPayment.Id"
           class="btn btn-primary-modern">
            + ثبت پرداخت جدید
        </a>

    </div>


    @if (payments != null && payments.Any())
    {
        <div class="modern-table-wrapper">

            <table class="table modern-table">

                <thead>
                    <tr>
                        <th>مرجع سند / تاریخ پرداخت</th>
                        <th>مبلغ</th>
                        <th>عملیات</th>
                    </tr>
                </thead>

                <tbody>

                    @foreach (var payment in payments)
                    {
                        <tr>

                            <td>
                                @payment.PaymentDocument.PaymentReferenceNo<br />@payment.PaymentDocument.PaymentDate
                            </td>

                            <td>
                                @payment.AllocatedAmount.ToString("N2")
                            </td>

                            <td>

                                <a asp-controller="Payments"
                                   asp-action="Details"
                                   asp-route-id="@payment.PaymentDocumentId"
                                   class="btn btn-outline-primary btn-sm btn-soft">
                                    جزئیات
                                </a>

                                <a asp-controller="Payments"
                                   asp-action="Edit"
                                   asp-route-id="@payment.PaymentDocumentId"
                                   class="btn btn-outline-warning btn-sm btn-soft">
                                    ویرایش
                                </a>

                            </td>

                        </tr>
                    }

                </tbody>

            </table>

        </div>
    }
    else
    {
        <div class="alert alert-secondary">
            هنوز پرداختی برای این صورت وضعیت ثبت نشده است.
        </div>
    }


    <div class="mt-4">

        <a asp-action="Edit"
           asp-route-id="@Model.ProgressPayment.Id"
           class="btn btn-warning">
            ویرایش صورت وضعیت
        </a>

        <a asp-action="Index"
           class="btn btn-secondary">
            بازگشت
        </a>

    </div>

</div>
