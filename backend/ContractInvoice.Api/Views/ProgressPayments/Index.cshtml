@model IEnumerable<ContractInvoice.Api.Model.ProgressPayment>

@{
    ViewData["Title"] = "صورت وضعیت‌ها";
}

<div class="page-container">

    <div class="page-header">

        <div>
            <h1 class="page-title">صورت وضعیت‌ها</h1>
            <p class="page-subtitle">
                مدیریت صورت وضعیت‌های قراردادها
            </p>
        </div>

        <a asp-action="Create"
           class="btn btn-primary-modern">
            + صورت وضعیت جدید
        </a>

    </div>

    <div class="modern-table-wrapper">

        <table class="table modern-table">

            <thead>
                <tr>
                    <th>قرارداد</th>
                    <th>شماره</th>
                    <th>عنوان</th>
                    <th>نوع</th>
                    <th>مبلغ پیشنهادی</th>
                    <th>مبلغ تایید شده</th>
                    <th>وضعیت</th>
                    <th>عملیات</th>
                </tr>
            </thead>

            <tbody>

                @foreach (var item in Model)
                {
                    <tr>

                        <td>
                            <strong>
                                @item.Contract.ContractCode
                            </strong>
                        </td>

                        <td>
                            @item.PaymentNo
                        </td>

                        <td>
                            @item.Title
                        </td>

                        <td>
                            @if (item.PaymentType == "TEMPORARY")
                            {
                                <span class="badge badge-soft-primary">
                                    موقت
                                </span>
                            }
                            else if (item.PaymentType == "FINAL")
                            {
                                <span class="badge badge-soft-success">
                                    قطعی
                                </span>
                            }
                            else if (item.PaymentType == "ADJUSTMENT")
                            {
                                <span class="badge badge-soft-warning">
                                    تعدیل
                                </span>
                            }
                        </td>

                        <td>
                            @item.ProposedAmount.ToString("N0")
                        </td>

                        <td>
                            @(item.ApprovedAmount?.ToString("N0") ?? "-")
                        </td>

                        <td>
                            @if (!string.IsNullOrWhiteSpace(item.Status))
                            {
                                <span class="badge badge-soft-secondary">
                                    @item.Status
                                </span>
                            }
                            else
                            {
                                <span>-</span>
                            }
                        </td>

                        <td>
                            <div class="d-flex gap-2 flex-wrap">

                                <a asp-action="Details"
                                   asp-route-id="@item.Id"
                                   class="btn btn-outline-primary btn-sm btn-soft">
                                    جزئیات
                                </a>

                                <a asp-action="Edit"
                                   asp-route-id="@item.Id"
                                   class="btn btn-outline-warning btn-sm btn-soft">
                                    ویرایش
                                </a>

                                <button type="button"
                                        class="btn btn-outline-danger btn-sm btn-soft"
                                        data-bs-toggle="modal"
                                        data-bs-target="#deleteProgressPaymentModal-@item.Id">
                                    حذف
                                </button>

                            </div>
                        </td>

                    </tr>
                }

            </tbody>

        </table>
        @foreach (var item in Model)
        {
            <div class="modal fade"
                id="deleteProgressPaymentModal-@item.Id"
                tabindex="-1"
                aria-hidden="true">

                <div class="modal-dialog modal-dialog-centered">

                    <div class="modal-content">

                        <div class="modal-header border-0">
                            <h5 class="modal-title">
                                حذف صورت وضعیت
                            </h5>
                        </div>

                        <div class="modal-body">

                            <div class="delete-warning">
                                 آیا از حذف این صورت وضعیت مطمئن هستید؟
                            </div>

                            <div class="delete-modal-grid">

                                <div class="delete-modal-card delete-card-blue">
                                    <div class="delete-modal-card-label">
                                        قرارداد
                                    </div>

                                    <div class="delete-modal-card-value">
                                        @item.Contract.ContractCode
                                    </div>
                                </div>

                                <div class="delete-modal-card delete-card-purple">
                                    <div class="delete-modal-card-label">
                                        شماره صورت وضعیت
                                    </div>

                                    <div class="delete-modal-card-value">
                                        @item.PaymentNo
                                    </div>
                                </div>

                                <div class="delete-modal-card delete-card-green">
                                    <div class="delete-modal-card-label">
                                        عنوان
                                    </div>

                                    <div class="delete-modal-card-value">
                                        @item.Title
                                    </div>
                                </div>

                                <div class="delete-modal-card delete-card-orange">
                                    <div class="delete-modal-card-label">
                                        مبلغ تایید شده
                                    </div>

                                    <div class="delete-modal-card-value">
                                        @(item.ApprovedAmount?.ToString("N0") ?? "-")
                                    </div>
                                </div>

                            </div>

                        </div>

                        <div class="modal-footer border-0">

                            <form asp-action="Delete"
                                asp-route-id="@item.Id"
                                method="post">

                                @Html.AntiForgeryToken()

                                <button type="submit"
                                        class="btn btn-danger">
                                    بله، حذف شود
                                </button>

                            </form>

                            <button type="button"
                                    class="btn btn-outline-secondary"
                                    data-bs-dismiss="modal">
                                انصراف
                            </button>

                        </div>

                    </div>

                </div>

            </div>
        }

    </div>

</div>