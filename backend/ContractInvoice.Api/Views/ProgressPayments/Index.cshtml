@model List<ContractInvoice.Api.Model.ProgressPayment>
@{
    ViewData["Title"] = "صورت وضعیت ها";
}
<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>صورت وضعیت ها</h2>
    <a asp-action="Create" class="btn btn-primary">صورت وضعیت جدید</a>
</div>
<table class="table table-striped table-bordered">
    <thead class="table-dark"><tr><th>قرارداد</th><th>شماره</th><th>عنوان</th><th>نوع</th><th>مبلغ پیشنهادی</th><th>وضعیت</th><th>عملیات</th></tr></thead>
    <tbody>
    @foreach (var payment in Model)
    {
        <tr>
            <td>@payment.Contract.ContractCode - @payment.Contract.Title</td><td>@payment.PaymentNo</td><td>@payment.Title</td><td>@payment.PaymentType</td>
            <td>@payment.ProposedAmount.ToString("N2")</td><td>@payment.Status</td>
            <td class="text-nowrap"><a asp-action="Details" asp-route-id="@payment.Id" class="btn btn-sm btn-outline-info">جزئیات</a> <a asp-action="Edit" asp-route-id="@payment.Id" class="btn btn-sm btn-outline-primary">ویرایش</a> <a asp-action="Delete" asp-route-id="@payment.Id" class="btn btn-sm btn-outline-danger">حذف</a></td>
        </tr>
    }
    </tbody>
</table>
