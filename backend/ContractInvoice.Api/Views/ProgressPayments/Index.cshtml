@model IEnumerable<ContractInvoice.Api.Model.ProgressPayment>

@{
    ViewData["Title"] = "صورت وضعیت‌ها";
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger">
        @TempData["ErrorMessage"]
    </div>
}

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success">
        @TempData["SuccessMessage"]
    </div>
}

<div class="page-container">

    <div class="page-header">

        <div>
            <h1 class="page-title">صورت وضعیت‌ها</h1>
            <p class="page-subtitle">
                مدیریت صورت وضعیت‌های قراردادها
            </p>
        </div>

        <a asp-action="Create"
           class="btn btn-primary-modern">
            + صورت وضعیت جدید
        </a>

    </div>

    <div class="card mb-4 shadow-sm">
        <div class="card-header bg-light d-flex align-items-center justify-content-between">
            <h6 class="mb-0">
                جستجو و فیلتر صورت‌وضعیت‌ها
            </h6>

            <button type="button"
                    id="clearProgressPaymentFilters"
                    class="btn btn-sm btn-outline-secondary">
                پاک کردن فیلترها
            </button>
        </div>

        <div class="card-body">
            <div class="row g-3">

                <div class="col-md-3">
                    <label class="form-label">شماره قرارداد</label>
                    <input type="text"
                        class="form-control progress-payment-filter"
                        data-field="contract-no"
                        placeholder="شماره قرارداد..." />
                </div>

                <div class="col-md-4">
                    <label class="form-label">موضوع قرارداد</label>
                    <input type="text"
                        class="form-control progress-payment-filter"
                        data-column="0"
                        data-field="contract-topic"
                        placeholder="موضوع قرارداد..." />
                </div>

                <div class="col-md-2">
                    <label class="form-label">نوع صورت‌وضعیت</label>
                    <select class="form-select progress-payment-filter"
                            data-field="payment-type">
                        <option value="">همه</option>
                        <option value="موقت">موقت</option>
                        <option value="قطعی">قطعی</option>
                        <option value="تعدیل">تعدیل</option>
                        <option value="پیش پرداخت">پیش پرداخت</option>
                    </select>
                </div>

                <div class="col-md-3">
                    <label class="form-label">وضعیت</label>
                    <select class="form-select progress-payment-filter"
                            data-field="status">
                        <option value="">همه</option>
                        <option value="FullyApproved">تأیید کامل شده</option>
                        <option value="PartiallyApproved">بخشی تأیید شده</option>
                        <option value="NotApproved">تأییدنشده</option>
                    </select>
                </div>

            </div>
        </div>
    </div>

    <div class="modern-table-wrapper">

        <table class="table modern-table">

            <thead>
                <tr>
                    <th>قرارداد</th>
                    <th>شماره</th>
                    <th>عنوان</th>
                    <th>نوع</th>
                    <th>مبلغ پیشنهادی</th>
                    <th>مبلغ تایید شده</th>
                    <th>وضعیت</th>
                    <th>عملیات</th>
                </tr>
            </thead>

            <tbody>

                @foreach (var item in Model)
                {
                    <tr data-contract-no="@item.Contract.ContractNo"
                        data-contract-topic="@item.Contract.Topic"
                        data-payment-type="@item.PaymentType"
                        data-status="@item.Status">

                        <td>
                            <strong>
                                @item.Contract.ContractNo
                            </strong>
                        </td>

                        <td>
                            @item.PaymentNo
                        </td>

                        <td>
                            @item.Title
                        </td>

                        <td>
                            @switch (item.PaymentType)
                            {
                                case "موقت":
                                    <span class="badge badge-soft-primary">موقت</span>
                                    break;

                                case "قطعی":
                                    <span class="badge badge-soft-success">قطعی</span>
                                    break;

                                case "تعدیل":
                                    <span class="badge badge-soft-warning">تعدیل</span>
                                    break;

                                case "پیش پرداخت":
                                case "پیش‌پرداخت":
                                    <span class="badge badge-soft-primary">پیش پرداخت</span>
                                    break;

                                default:
                                    <span>-</span>
                                    break;
                            }
                        </td>

                        <td>
                            @item.ProposedAmount.ToString("N0")
                        </td>

                        <td>
                            @(item.ApprovedAmount?.ToString("N0") ?? "-")
                        </td>

                        <td>
                            @switch (item.Status)
                            {
                                case "FullyApproved":
                                    <span class="badge bg-success">تأیید کامل شده</span>
                                    break;

                                case "PartiallyApproved":
                                    <span class="badge bg-warning text-dark">بخشی تأیید شده</span>
                                    break;

                                case "NotApproved":
                                default:
                                    <span class="badge bg-danger">تأییدنشده</span>
                                    break;
                            }
                        </td>

                        <td>
                            <div class="d-flex gap-2 flex-wrap">

                                <a asp-action="Details"
                                   asp-route-id="@item.Id"
                                   class="btn btn-outline-primary btn-sm btn-soft">
                                    جزئیات
                                </a>

                                <a asp-action="Edit"
                                   asp-route-id="@item.Id"
                                   class="btn btn-outline-warning btn-sm btn-soft">
                                    ویرایش
                                </a>

                                <button type="button"
                                        class="btn btn-outline-danger btn-sm btn-soft"
                                        data-bs-toggle="modal"
                                        data-bs-target="#deleteProgressPaymentModal-@item.Id">
                                    حذف
                                </button>

                            </div>
                        </td>

                    </tr>
                }

            </tbody>

        </table>
        @foreach (var item in Model)
        {
            <div class="modal fade"
                id="deleteProgressPaymentModal-@item.Id"
                tabindex="-1"
                aria-hidden="true">

                <div class="modal-dialog modal-dialog-centered">

                    <div class="modal-content">

                        <div class="modal-header border-0">
                            <h5 class="modal-title">
                                حذف صورت وضعیت
                            </h5>
                        </div>

                        <div class="modal-body">

                            <div class="delete-warning">
                                 آیا از حذف این صورت وضعیت مطمئن هستید؟
                            </div>

                            <div class="delete-modal-grid">

                                <div class="delete-modal-card delete-card-blue">
                                    <div class="delete-modal-card-label">
                                        قرارداد
                                    </div>

                                    <div class="delete-modal-card-value">
                                        @item.Contract.ContractNo
                                    </div>
                                </div>

                                <div class="delete-modal-card delete-card-purple">
                                    <div class="delete-modal-card-label">
                                        شماره صورت وضعیت
                                    </div>

                                    <div class="delete-modal-card-value">
                                        @item.PaymentNo
                                    </div>
                                </div>

                                <div class="delete-modal-card delete-card-green">
                                    <div class="delete-modal-card-label">
                                        عنوان
                                    </div>

                                    <div class="delete-modal-card-value">
                                        @item.Title
                                    </div>
                                </div>

                                <div class="delete-modal-card delete-card-orange">
                                    <div class="delete-modal-card-label">
                                        مبلغ تایید شده
                                    </div>

                                    <div class="delete-modal-card-value">
                                        @(item.ApprovedAmount?.ToString("N0") ?? "-")
                                    </div>
                                </div>

                            </div>

                        </div>

                        <div class="modal-footer border-0">

                            <form asp-action="Delete"
                                asp-route-id="@item.Id"
                                method="post">

                                @Html.AntiForgeryToken()

                                <button type="submit"
                                        class="btn btn-danger">
                                    بله، حذف شود
                                </button>

                            </form>

                            <button type="button"
                                    class="btn btn-outline-secondary"
                                    data-bs-dismiss="modal">
                                انصراف
                            </button>

                        </div>

                    </div>

                </div>

            </div>
        }

    </div>
    <script>
        document.addEventListener('DOMContentLoaded', function () {

            const filters = document.querySelectorAll('.progress-payment-filter');
            const rows = document.querySelectorAll('.modern-table tbody tr');
            const clearButton = document.getElementById('clearProgressPaymentFilters');

            function normalizeText(value) {
                return (value || '')
                    .replace(/\u200c/g, '')
                    .replace(/\s+/g, ' ')
                    .trim()
                    .toLowerCase();
            }

            function applyFilters() {
                rows.forEach(row => {
                    const contractNo = normalizeText(row.dataset.contractNo);
                    const contractTopic = normalizeText(row.dataset.contractTopic);
                    const paymentType = normalizeText(row.dataset.paymentType);
                    const status = normalizeText(row.dataset.status);

                    let visible = true;

                    filters.forEach(filter => {
                        const filterValue = normalizeText(filter.value);

                        if (!filterValue) return;

                        const field = filter.dataset.field;
                        let rowValue = '';

                        switch (field) {
                            case 'contract-no':
                                rowValue = contractNo;
                                break;
                            case 'contract-topic':
                                rowValue = contractTopic;
                                break;
                            case 'payment-type':
                                rowValue = paymentType;
                                break;
                            case 'status':
                                rowValue = status;
                                break;
                        }

                        if (!rowValue.includes(filterValue)) {
                            visible = false;
                        }
                    });

                    row.style.display = visible ? '' : 'none';
                });
            }

            filters.forEach(filter => {
                filter.addEventListener('input', applyFilters);
                filter.addEventListener('change', applyFilters);
            });

            if (clearButton) {
                clearButton.addEventListener('click', function () {
                    filters.forEach(filter => {
                        filter.value = '';
                    });

                    applyFilters();
                });
            }
        });
    </script>

</div>