@model ContractInvoice.Api.Model.ProgressPayment

@{
    ViewData["Title"] = "حذف صورت وضعیت";
}

<div class="page-container">

    <div class="page-header">
        <div>
            <h1 class="page-title">حذف صورت وضعیت</h1>
            <p class="page-subtitle">
                بررسی نهایی قبل از حذف صورت وضعیت
            </p>
        </div>
    </div>

    <div class="delete-card">

        <div asp-validation-summary="ModelOnly"
             class="alert alert-danger">
        </div>

        <div class="delete-warning">
            آیا از حذف این صورت وضعیت مطمئن هستید؟
        </div>

        <div class="delete-summary">

            <div class="delete-item">
                <div class="delete-item-label">قرارداد</div>
                <div class="delete-item-value">
                    @Model.Contract.ContractCode
                </div>
            </div>

            <div class="delete-item">
                <div class="delete-item-label">شماره صورت وضعیت</div>
                <div class="delete-item-value">
                    @Model.PaymentNo
                </div>
            </div>

            <div class="delete-item">
                <div class="delete-item-label">عنوان</div>
                <div class="delete-item-value">
                    @Model.Title
                </div>
            </div>

            <div class="delete-item">
                <div class="delete-item-label">مبلغ تایید شده</div>
                <div class="delete-item-value">
                    @(Model.ApprovedAmount?.ToString("N0") ?? "-")
                </div>
            </div>

        </div>

        <form asp-action="Delete" method="post">

            <input type="hidden"
                   asp-for="Id" />

            <div class="delete-actions">

                <button type="submit"
                        class="btn btn-danger">
                    حذف صورت وضعیت
                </button>

                <a asp-action="Index"
                   class="btn btn-outline-secondary">
                    انصراف
                </a>

            </div>

        </form>

    </div>

</div>