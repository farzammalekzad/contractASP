<!DOCTYPE html>
<html lang="fa" dir="rtl">
@{
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
}
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - سامانه مدیریت قرارداد</title>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>

    <link href="https://fonts.googleapis.com/css2?family=Vazirmatn:wght@400;500;600;700;800&display=swap"
          rel="stylesheet">

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.rtl.min.css" />

    <link rel="stylesheet"
          href="~/css/site.css"
          asp-append-version="true" />
    <link rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
</head>

<body>

    <div class="app-shell">

        <aside class="app-sidebar">

            <div class="sidebar-brand">
                <div class="sidebar-logo">
                    CM
                </div>

                <div>
                    <div class="sidebar-title">
                        مدیریت قرارداد
                    </div>

                    <div class="sidebar-subtitle">
                        Contract Management
                    </div>
                </div>
            </div>


            <nav class="sidebar-nav">

                <a asp-controller="Home"
                   asp-action="Index"
                   class="sidebar-link @(currentController == "Home" ? "active" : "")">

                    <span class="sidebar-icon">
                        <i class="bi bi-house-door"></i>
                    </span>
                    <span>خانه</span>
                </a>


                <a asp-controller="Contracts"
                   asp-action="Index"
                   class="sidebar-link @(currentController == "Contracts" ? "active" : "")">

                    <span class="sidebar-icon">
                        <i class="bi bi-file-earmark-text"></i>
                    </span>
                    <span>قراردادها</span>
                </a>


                <a asp-controller="ProgressPayments"
                   asp-action="Index"
                   class="sidebar-link @(currentController == "ProgressPayments" ? "active" : "")">

                    <span class="sidebar-icon">
                        <i class="bi bi-receipt"></i>
                    </span>
                    <span>صورت وضعیت‌ها</span>
                </a>


                <a asp-controller="Payments"
                   asp-action="Index"
                   class="sidebar-link @(currentController == "Payments" ? "active" : "")">

                    <span class="sidebar-icon">
                        <i class="bi bi-credit-card"></i>
                    </span>
                    <span>پرداخت‌ها</span>
                </a>

            </nav>


            <div class="sidebar-footer">
                نسخه MVP
            </div>

        </aside>


        <main class="app-main">

           


            <div class="app-content">

                @RenderBody()

            </div>

        </main>

    </div>


    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js">
    </script>

    <script>
        const toggleButton = document.getElementById("sidebarToggle");

        if (toggleButton) {
            toggleButton.addEventListener("click", function () {
                document.body.classList.toggle("sidebar-open");
            });
        }
    </script>

    @await RenderSectionAsync("Scripts", required: false)

</body>

</html>