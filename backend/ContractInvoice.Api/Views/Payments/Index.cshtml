@model IEnumerable<ContractInvoice.Api.Model.Payment>

@{
    ViewData["Title"] = "پرداخت‌ها";
}

<div class="page-container">

    <div class="page-header">

        <div>
            <h1 class="page-title">پرداخت‌ها</h1>
            <p class="page-subtitle">
                مشاهده و مدیریت پرداخت‌های صورت وضعیت‌ها
            </p>
        </div>

        <a asp-action="Create"
           class="btn btn-primary-modern">
            + ثبت پرداخت جدید
        </a>

    </div>

    <div class="modern-table-wrapper">

        <table class="table modern-table">

            <thead>
                <tr>
                    <th>قرارداد</th>
                    <th>صورت وضعیت</th>
                    <th>تاریخ پرداخت</th>
                    <th>مبلغ</th>
                    <th>شماره مرجع</th>
                    <th>عملیات</th>
                </tr>
            </thead>

            <tbody>

                @foreach (var item in Model)
                {
                    <tr>

                        <td>
                            <strong>
                                @item.ProgressPayment.Contract.ContractCode
                            </strong>
                        </td>

                        <td>
                            صورت وضعیت @item.ProgressPayment.PaymentNo
                        </td>

                        <td>
                            @item.PaymentDate
                        </td>

                        <td>
                            @item.ReceivedAmount.ToString("N0")
                        </td>

                        <td>
                            @(item.PaymentReferenceNo ?? "-")
                        </td>

                        <td>
                            <div class="d-flex gap-2 flex-wrap">

                                <a asp-action="Details"
                                   asp-route-id="@item.Id"
                                   class="btn btn-outline-primary btn-sm btn-soft">
                                    جزئیات
                                </a>

                                <a asp-action="Edit"
                                   asp-route-id="@item.Id"
                                   class="btn btn-outline-warning btn-sm btn-soft">
                                    ویرایش
                                </a>

                                <a asp-action="Delete"
                                   asp-route-id="@item.Id"
                                   class="btn btn-outline-danger btn-sm btn-soft">
                                    حذف
                                </a>

                            </div>
                        </td>

                    </tr>
                }

            </tbody>

        </table>

    </div>

</div>