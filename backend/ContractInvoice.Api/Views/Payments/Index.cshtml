@model IEnumerable<ContractInvoice.Api.Model.Payment>

@{
    ViewData["Title"] = "پرداخت‌ها";
}

<div class="page-container">

    <div class="page-header">

        <div>
            <h1 class="page-title">پرداخت‌ها</h1>
            <p class="page-subtitle">
                مشاهده و مدیریت پرداخت‌های صورت وضعیت‌ها
            </p>
        </div>

        <a asp-action="Create"
           class="btn btn-primary-modern">
            + ثبت پرداخت جدید
        </a>

    </div>

    <div class="modern-table-wrapper">

        <table class="table modern-table">

            <thead>
                <tr>
                    <th>قرارداد</th>
                    <th>صورت وضعیت</th>
                    <th>تاریخ پرداخت</th>
                    <th>مبلغ</th>
                    <th>شماره مرجع</th>
                    <th>عملیات</th>
                </tr>
            </thead>

            <tbody>

                @foreach (var item in Model)
                {
                    <tr>

                        <td>
                            <strong>
                                @item.ProgressPayment.Contract.ContractNo
                            </strong>
                        </td>

                        <td>
                            صورت وضعیت @item.ProgressPayment.PaymentNo
                        </td>

                        <td>
                            @item.PaymentDate
                        </td>

                        <td>
                            @item.ReceivedAmount.ToString("N0")
                        </td>

                        <td>
                            @(item.PaymentReferenceNo ?? "-")
                        </td>

                        <td>
                            <div class="d-flex gap-2 flex-wrap">

                                <a asp-action="Details"
                                   asp-route-id="@item.Id"
                                   class="btn btn-outline-primary btn-sm btn-soft">
                                    جزئیات
                                </a>

                                <a asp-action="Edit"
                                   asp-route-id="@item.Id"
                                   class="btn btn-outline-warning btn-sm btn-soft">
                                    ویرایش
                                </a>

                                <button type="button"
                                        class="btn btn-outline-danger btn-sm btn-soft"
                                        data-bs-toggle="modal"
                                        data-bs-target="#deletePaymentModal-@item.Id">
                                    حذف
                                </button>

                            </div>
                        </td>

                    </tr>
                }

            </tbody>

        </table>
        @foreach (var item in Model)
        {
            <div class="modal fade"
                id="deletePaymentModal-@item.Id"
                tabindex="-1"
                aria-hidden="true">

                <div class="modal-dialog modal-dialog-centered">

                    <div class="modal-content">

                        <div class="modal-header border-0">
                            <h5 class="modal-title">
                                حذف پرداخت
                            </h5>

                        </div>

                        <div class="modal-body">

                            <div class="delete-warning">
                                 آیا از حذف این پرداخت مطمئن هستید؟
                            </div>

                            <div class="delete-modal-grid">

                                <div class="delete-modal-card delete-card-blue">
                                    <div class="delete-modal-card-label">
                                        قرارداد
                                    </div>

                                    <div class="delete-modal-card-value">
                                        @item.ProgressPayment.Contract.ContractNo
                                    </div>
                                </div>

                                <div class="delete-modal-card delete-card-purple">
                                    <div class="delete-modal-card-label">
                                        صورت وضعیت
                                    </div>

                                    <div class="delete-modal-card-value">
                                        شماره @item.ProgressPayment.PaymentNo
                                    </div>
                                </div>

                                <div class="delete-modal-card delete-card-green">
                                    <div class="delete-modal-card-label">
                                        تاریخ پرداخت
                                    </div>

                                    <div class="delete-modal-card-value">
                                        @item.PaymentDate
                                    </div>
                                </div>

                                <div class="delete-modal-card delete-card-orange">
                                    <div class="delete-modal-card-label">
                                        مبلغ پرداخت
                                    </div>

                                    <div class="delete-modal-card-value">
                                        @item.ReceivedAmount.ToString("N0")
                                    </div>
                                </div>

                            </div>

                        </div>

                        <div class="modal-footer border-0">

                            <form asp-action="Delete"
                                asp-route-id="@item.Id"
                                method="post">

                                @Html.AntiForgeryToken()

                                <button type="submit"
                                        class="btn btn-danger">
                                    بله، حذف شود
                                </button>

                            </form>

                            <button type="button"
                                    class="btn btn-outline-secondary"
                                    data-bs-dismiss="modal">
                                انصراف
                            </button>

                        </div>

                    </div>

                </div>

            </div>
        }

    </div>

</div>