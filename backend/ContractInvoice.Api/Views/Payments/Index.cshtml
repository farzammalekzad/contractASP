@model ContractInvoice.Api.ViewModels.PaymentDocumentListModel
@{ ViewData["Title"] = "اسناد پرداخت"; }
<div class="page-container" dir="rtl">
<div class="page-header"><h1 class="page-title">اسناد پرداخت</h1><a asp-action="Create" class="btn btn-primary">ثبت سند پرداخت</a></div>
<p>همه مبالغ به ریال، با دو رقم اعشار</p>
<div class="table-responsive"><table class="table table-striped align-middle"><thead><tr><th>شماره مرجع</th><th>تاریخ شمسی</th><th>مبلغ سند</th><th>تخصیص‌یافته</th><th>تخصیص‌نیافته</th><th>توضیحات</th><th>عملیات</th></tr></thead><tbody>
@foreach (var row in Model.Documents) {
<tr><td>@row.Document.PaymentReferenceNo</td><td>@row.Document.PaymentDate</td><td>@row.Document.TotalAmount.ToString("N2")</td><td>@row.TotalAllocated.ToString("N2")</td><td>@row.UnallocatedAmount.ToString("N2")</td><td>@row.Document.Description</td><td class="text-nowrap"><a asp-action="Details" asp-route-id="@row.Document.Id" class="btn btn-sm btn-outline-primary">جزئیات</a> <a asp-action="Edit" asp-route-id="@row.Document.Id" class="btn btn-sm btn-outline-warning">ویرایش</a> <a asp-action="Delete" asp-route-id="@row.Document.Id" class="btn btn-sm btn-outline-danger">حذف</a></td></tr>
}
</tbody></table></div>
@if (Model.Documents.Count == 0) { <p class="alert alert-info">سندی در این صفحه وجود ندارد.</p> }
<nav aria-label="صفحه‌بندی">@if (Model.Skip > 0) { <a asp-action="Index" asp-route-skip="@Math.Max(0, Model.Skip - Model.Take)" asp-route-take="@Model.Take" class="btn btn-outline-secondary">قبلی</a> } @if (Model.Documents.Count == Model.Take) { <a asp-action="Index" asp-route-skip="@(Model.Skip + Model.Take)" asp-route-take="@Model.Take" class="btn btn-outline-secondary">بعدی</a> }</nav>
</div>
