@model ContractInvoice.Api.ViewModels.PaymentDocumentDeleteModel
@{ ViewData["Title"] = "حذف سند پرداخت"; }
<div class="page-container" dir="rtl"><h1 class="page-title">تأیید حذف سند پرداخت</h1><div asp-validation-summary="All" class="alert alert-danger"></div>
@if (!ViewData.ModelState.IsValid) { <p class="alert alert-info">حذف انجام نشد. اگر نسخه سند تغییر کرده است، با پیوند زیر نسخه جدید را بارگذاری و دوباره تأیید کنید.</p> }
<p class="alert alert-warning">با حذف سند، همه تخصیص‌های زیر حذف می‌شوند. اطلاعات را بررسی کنید.</p>
<partial name="_Document" model="Model.Document" />
<form asp-action="Delete" asp-route-id="@Model.Document.Document.Id" method="post">
<input type="hidden" name="Input.RowVersion" value="@Convert.ToBase64String(Model.Input.RowVersion)" />
<div class="form-check mb-3"><input asp-for="Input.Confirmed" class="form-check-input" required /><label asp-for="Input.Confirmed" class="form-check-label">سند و همه تخصیص‌ها را بررسی کردم و حذف را تأیید می‌کنم.</label></div>
<button class="btn btn-danger" type="submit">حذف سند و تخصیص‌ها</button> <a asp-action="Details" asp-route-id="@Model.Document.Document.Id" class="btn btn-secondary">انصراف</a>
<a asp-action="Delete" asp-route-id="@Model.Document.Document.Id" class="btn btn-outline-primary">بارگذاری نسخه جدید برای بررسی دوباره</a>
<p class="form-text">اگر سند تغییر کرده است، نسخه جدید را بارگذاری و دوباره بررسی کنید؛ درخواست قبلی خودکار تکرار نمی‌شود.</p></form></div>
