@model ContractInvoice.Api.Model.Payment

@{
    ViewData["Title"] = "حذف پرداخت";
}

<div class="page-container">

    <div class="page-header">
        <div>
            <h1 class="page-title">حذف پرداخت</h1>
            <p class="page-subtitle">
                بررسی نهایی قبل از حذف پرداخت
            </p>
        </div>
    </div>

    <div class="delete-card">

        <div class="delete-warning">
            آیا از حذف این پرداخت مطمئن هستید؟
        </div>

        <div class="delete-summary">

            <div class="delete-item">
                <div class="delete-item-label">قرارداد</div>
                <div class="delete-item-value">
                    @Model.ProgressPayment.Contract.ContractCode
                </div>
            </div>

            <div class="delete-item">
                <div class="delete-item-label">صورت وضعیت</div>
                <div class="delete-item-value">
                    شماره @Model.ProgressPayment.PaymentNo
                </div>
            </div>

            <div class="delete-item">
                <div class="delete-item-label">تاریخ پرداخت</div>
                <div class="delete-item-value">
                    @Model.PaymentDate
                </div>
            </div>

            <div class="delete-item">
                <div class="delete-item-label">مبلغ</div>
                <div class="delete-item-value">
                    @Model.ReceivedAmount.ToString("N0")
                </div>
            </div>

        </div>

        <form asp-action="Delete" method="post">

            <input type="hidden"
                   name="id"
                   value="@Model.Id" />

            <div class="delete-actions">

                <button type="submit"
                        class="btn btn-danger">
                    حذف پرداخت
                </button>

                <a asp-action="Index"
                   class="btn btn-outline-secondary">
                    انصراف
                </a>

            </div>

        </form>

    </div>

</div>