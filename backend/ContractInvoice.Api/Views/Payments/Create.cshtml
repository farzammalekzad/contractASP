@model ContractInvoice.Api.DTOs.CreatePaymentDto

@{
    ViewData["Title"] = "ثبت پرداخت";
}

<div class="page-container compact-form">

    <div class="page-header">
        <div>
            <h1 class="page-title">ثبت پرداخت جدید</h1>
            <p class="page-subtitle">
                اطلاعات پرداخت را وارد کنید
            </p>
        </div>
    </div>

    <form asp-action="Create" method="post">

        <div asp-validation-summary="ModelOnly"
             class="alert alert-danger">
        </div>

        <div class="form-section">

            <div class="form-section-title">
                اطلاعات پرداخت
            </div>

            <div class="form-grid">

                <div class="form-field form-field-full">
                    <label asp-for="ProgressPaymentId"
                           class="form-label"></label>

                    <select asp-for="ProgressPaymentId"
                            asp-items="ViewBag.ProgressPayments"
                            class="form-select">
                        <option value="">-- انتخاب صورت وضعیت --</option>
                    </select>

                    <span asp-validation-for="ProgressPaymentId"
                          class="text-danger"></span>
                </div>

                <div class="form-field">
                    <label asp-for="PaymentDate"
                           class="form-label"></label>

                    <input asp-for="PaymentDate"
                           class="form-control"
                           data-jdp
                           placeholder="1405/07/20" />

                    <span asp-validation-for="PaymentDate"
                          class="text-danger"></span>
                </div>

                <div class="form-field">
                    <label asp-for="ReceivedAmount"
                           class="form-label"></label>

                    <input asp-for="ReceivedAmount"
                           class="form-control" />

                    <span asp-validation-for="ReceivedAmount"
                          class="text-danger"></span>
                </div>

                <div class="form-field">
                    <label asp-for="PaymentReferenceNo"
                           class="form-label"></label>

                    <input asp-for="PaymentReferenceNo"
                           class="form-control" />
                </div>

                <div class="form-field">
                    <label asp-for="Description"
                           class="form-label"></label>

                    <input asp-for="Description"
                           class="form-control" />
                </div>

            </div>

        </div>

        <div class="form-actions">

            <button type="submit"
                    class="btn btn-primary-modern">
                ذخیره پرداخت
            </button>

            <a asp-action="Index"
               class="btn btn-outline-secondary btn-soft">
                انصراف
            </a>

        </div>

    </form>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}