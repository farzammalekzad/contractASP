@model ContractInvoice.Api.DTOs.UpdatePaymentDto

@{
    ViewData["Title"] = "ویرایش پرداخت";
}

<div class="page-container compact-form">

    <div class="page-header">
        <div>
            <h1 class="page-title">ویرایش پرداخت </h1>
            <p class="page-subtitle">
                اطلاعات پرداخت را ویرایش کنید
            </p>
        </div>
    </div>

    <form asp-action="Edit" method="post">

        <div asp-validation-summary="ModelOnly"
             class="alert alert-danger">
        </div>

        <div class="form-section">

            <div class="form-section-title">
                اطلاعات پرداخت
            </div>

            <div class="form-grid">

                <div class="form-field form-field-full">
                    <label asp-for="ProgressPaymentId"
                           class="form-label"></label>

                    <select asp-for="ProgressPaymentId"
                            asp-items="ViewBag.ProgressPayments"
                            class="form-select">
                        <option value="">-- انتخاب صورت وضعیت --</option>
                    </select>

                    <span asp-validation-for="ProgressPaymentId"
                          class="text-danger"></span>
                </div>

                <div class="form-field">
                    <label asp-for="PaymentDate"
                           class="form-label"></label>

                    <input asp-for="PaymentDate"
                           class="form-control"
                           data-jdp
                           placeholder="1405/07/20" />

                    <span asp-validation-for="PaymentDate"
                          class="text-danger"></span>
                </div>

                <div class="form-field">
                    <label asp-for="ReceivedAmount"
                           class="form-label"></label>

                    <input asp-for="ReceivedAmount"
                           class="form-control" />

                    <span asp-validation-for="ReceivedAmount"
                          class="text-danger"></span>
                </div>

                <div class="form-field">
                    <label asp-for="GoodPerformance" class="form-label"></label>
                    <input asp-for="GoodPerformance" class="form-control" />
                    <span asp-validation-for="GoodPerformance" class="text-danger"></span>
                </div>

                <div class="form-field">
                    <label asp-for="InsuranceDeposit" class="form-label"></label>
                    <input asp-for="InsuranceDeposit" class="form-control" />
                    <span asp-validation-for="InsuranceDeposit" class="text-danger"></span>
                </div>

                <div class="form-field">
                    <label asp-for="ObligationsDeposit" class="form-label"></label>
                    <input asp-for="ObligationsDeposit" class="form-control" />
                    <span asp-validation-for="ObligationsDeposit" class="text-danger"></span>
                </div>

                <div class="form-field">
                    <label asp-for="VatReceivable" class="form-label"></label>
                    <input asp-for="VatReceivable" class="form-control" />
                    <span asp-validation-for="VatReceivable" class="text-danger"></span>
                </div>

                <div class="form-field">
                    <label asp-for="RadiationAllowance" class="form-label"></label>
                    <input asp-for="RadiationAllowance" class="form-control" />
                    <span asp-validation-for="RadiationAllowance" class="text-danger"></span>
                </div>

                <div class="form-field">
                    <label asp-for="ForeignMission" class="form-label"></label>
                    <input asp-for="ForeignMission" class="form-control" />
                    <span asp-validation-for="ForeignMission" class="text-danger"></span>
                </div>

                <div class="form-field">
                    <label asp-for="Description"
                           class="form-label"></label>

                    <input asp-for="Description"
                           class="form-control" />
                </div>

            </div>

        </div>

        <div class="form-actions">

            <button type="submit"
                    class="btn btn-primary-modern">
                ذخیره تغییرات
            </button>

            <a asp-action="Index"
               class="btn btn-outline-secondary btn-soft">
                انصراف
            </a>

        </div>

    </form>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}