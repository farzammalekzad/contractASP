@model ContractInvoice.Api.ViewModels.PaymentDocumentFormModel
@{ ViewData["Title"] = "ویرایش سند پرداخت"; }
<div class="page-container" dir="rtl"><h1 class="page-title">ویرایش سند پرداخت</h1>
<form id="payment-form" asp-action="Edit" asp-route-id="@ViewContext.RouteData.Values["id"]" method="post" data-document-id="@ViewContext.RouteData.Values["id"]" data-preview-url="@Url.Action("PreviewAllocation")" data-eligible-url="@Url.Action("EligibleProgressPayments")" data-totals-url="@Url.Action("Totals")">
<partial name="_Form" model="Model" />
</form></div>
@section Scripts { <script src="~/js/payment-document.js" asp-append-version="true"></script> }
